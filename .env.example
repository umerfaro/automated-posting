# Copy to .env. Set real credentials locally. Never commit .env.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
# Public channel username. Add the bot as an administrator with Post Messages.
TELEGRAM_CHANNEL=@your_public_channel
# Optional access key. If set, requests require X-API-Key.
APP_API_KEY=
HTTP_TIMEOUT_SECONDS=20
DATABASE_PATH=data/posting.sqlite3

# Video accounts use separate developer apps and explicit account authorization.
APP_BASE_URL=http://127.0.0.1:4000
PUBLIC_MEDIA_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MAX_VIDEO_MB=250

# SaaS mode is enabled by default. Set false only for a separate legacy assessment database.
SAAS_ENABLED=true
# Register your operator account, then run: python -m app.manage promote your@email.com
ADMIN_EMAIL=
# Optional Fernet key. If empty, an owner-only data/master.key is created locally.
# Keep the key with your backups. Use a secret manager for public deployments.
ENCRYPTION_KEY=
FREE_MONTHLY_POSTS=50
PRO_MONTHLY_POSTS=1000
# Stripe infrastructure is inactive until all three are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Comma-separated trusted browser hostnames. Empty uses the APP_BASE_URL hostname.
ALLOWED_HOSTS=

# Explicit social API hosts customers may configure. Add approved Mastodon/PDS servers here.
SOCIAL_ALLOWED_HOSTS=mastodon.social,bsky.social

# Email verification defaults to required for an HTTPS APP_BASE_URL.
# REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
