# Copy to .env. Set real credentials locally. Never commit .env.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
# Public channel username. Add the bot as an administrator with Post Messages.
TELEGRAM_CHANNEL=@your_public_channel
# Optional access key. If set, requests require X-API-Key.
APP_API_KEY=
HTTP_TIMEOUT_SECONDS=20
DATABASE_PATH=data/posting.sqlite3

# Video accounts use separate developer apps and explicit account authorization.
APP_BASE_URL=http://127.0.0.1:4000
PUBLIC_MEDIA_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
MAX_VIDEO_MB=250
